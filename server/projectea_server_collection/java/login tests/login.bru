meta {
  name: Login (create session)
  type: http
  seq: 1
}

post {
  url: https://localhost/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "OGT_SHADOW",
    "password": "DwukropekTrzy"
  }
}

tests {
  test("Login returns 200 and sets session cookie", async function () {
    expect(res.status).to.equal(200);
    const setCookie =
      res.getHeader("set-cookie") ||
      res.getHeader("Set-Cookie") ||
      (res.headers && (res.headers["set-cookie"] || res.headers["Set-Cookie"]));

    expect(setCookie).to.include("PT_SESSION=");

    const rawCookie = Array.isArray(setCookie) ? setCookie[0] : setCookie;
    const sessionCookie = (rawCookie || "").split(";")[0];

    bru.setVar("sessionCookie", sessionCookie);
    bru.setEnvVar("sessionCookie", sessionCookie);

    expect(res.body.username).to.equal("OGT_SHADOW");
  });
}
