# Oficjalny obraz Playwright z zainstalowanymi przeglądarkami
FROM mcr.microsoft.com/playwright:v1.60.0-jammy

WORKDIR /app

# Kopiujemy pliki konfiguracyjne (zakładam, że package.json jest w głównym folderze 
# lub w folderze z testami - dostosuj ścieżkę jeśli trzeba)
COPY package*.json ./
COPY playwright.config.ts ./

# Instalujemy zależności projektowe
RUN npm ci

# Kopiujemy resztę kodu testów
COPY tests ./tests

# Domyślna komenda uruchamiająca testy
CMD ["npx", "playwright", "test"]